# CraftSure AI API — Environment Variables
# Copy to .env and fill in your values.
# NEVER commit .env to version control.

PORT=4000
CORS_ORIGIN=http://localhost:3000

# Supabase Auth & PostgreSQL Database
# SUPABASE_ANON_KEY is the preferred least-privileged key for verifying user session tokens.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional server-side service role key (keep strictly confidential, never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=

# Database connection string (Supabase PostgreSQL with pgBouncer / transaction pooler)
DATABASE_URL=

# Razorpay Payment Gateway (Test Mode / Production)
# Obtain from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Obtain from Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=
