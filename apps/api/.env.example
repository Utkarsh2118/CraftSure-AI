# CraftSure AI API — Environment Variables
# Copy to .env and fill in your values.

PORT=4000
CORS_ORIGIN=http://localhost:3000

# Supabase Auth
# SUPABASE_ANON_KEY is the preferred least-privileged key for verifying user session tokens.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional server-side service role key (keep strictly confidential, never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=

# Database connection string (Supabase PostgreSQL)
DATABASE_URL=
