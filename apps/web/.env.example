# CraftSure AI — Environment Variables
# Copy to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# Supabase (from your Supabase project settings -> API)
# For Google OAuth: configure Google Client ID & Secret in Supabase Dashboard -> Authentication -> Providers -> Google
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# API base URL (Next.js frontend → Express API)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Razorpay Public Key ID (Client-side checkout script)
# Obtain from Razorpay Dashboard -> Settings -> API Keys (rzp_test_...)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
